<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.proiect.controller.PacientDashboardController" stylesheets="@style.css">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="5">
        <Label fx:id="etichetaBunVenit" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label fx:id="etichetaExpirare" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
    </VBox>

    <Label text="Istoricul tău medical:" style="-fx-font-weight: bold;" />

    <TableView fx:id="tabelIstoric" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colData" text="Data" />
            <TableColumn fx:id="colDiagProv" text="Diagnostic Provizoriu" />
            <TableColumn fx:id="colDiagFinal" text="Diagnostic Final" />
            <TableColumn fx:id="colReteta" text="Rețetă" />
            <TableColumn fx:id="colRecomandari" text="Recomandări" />
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button text="Evaluare Nouă" onAction="#deschideEvaluare" />
        <Button text="Reînnoiește Abonament" onAction="#reinnoiesteAbonament" />
        <Button text="Refresh Date" onAction="#incarcaDateIstoric"/>
        <Button text="Log Out" onAction="#logout"/>

        <Button text="Vezi Programarea Activă" onAction="#arataBiletProgramare"
                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>