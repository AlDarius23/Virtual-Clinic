<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proiect.controller.DoctorDashboardController"
      stylesheets="@style.css"
      spacing="15"
      style="-fx-padding: 20;">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="etichetaBunVenit" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Reîncarcă" onAction="#incarcaProgramari"/>
        <Button text="Deconectare" onAction="#logout" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <Separator/>

    <Label text="Programările mele:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>

    <TableView fx:id="tabelProgramari" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colData"             text="Data și Ora" />
            <TableColumn fx:id="colPacient"          text="Pacient" />
            <TableColumn fx:id="colTelefon"          text="Telefon" />
            <TableColumn fx:id="colSimptome"         text="Simptome" />
            <TableColumn fx:id="colDescrierePacient" text="Descriere Pacient" />
            <TableColumn fx:id="colStatus"           text="Status" />
        </columns>
        <placeholder>
            <Label text="Nu există programări." style="-fx-text-fill: #94a3b8;"/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="✔ Finalizează Consultația Selectată" onAction="#finalizeazaConsultatie" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
    </HBox>
</VBox>